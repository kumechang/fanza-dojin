# Claude (Anthropic) API - 投稿時間帯の重み分析(analyze-posting-times)にのみ使用
ANTHROPIC_API_KEY=

# FANZA (DMM) Affiliate API
FANZA_API_ID=
FANZA_AFFILIATE_ID=

# X (Twitter) API v2 - user context (OAuth 1.0a)
# X_API_KEY/X_API_SECRETはDeveloper登録したアプリキーで全アカウント共通。
# X_ACCOUNTS_JSONは投稿先アカウントごとのaccessToken/accessSecretをJSON配列で持つ
# (npm run get-x-token:start / get-x-token:finish -- <PIN> で1アカウントずつ取得できる)。
# 例: [{"name":"account1","accessToken":"...","accessSecret":"..."},{"name":"account2","accessToken":"...","accessSecret":"..."}]
X_API_KEY=
X_API_SECRET=
X_ACCOUNTS_JSON=

# Telegram (approvalMode: "telegram"のときの黒塗り結果の確認・承認用)
# TELEGRAM_BOT_TOKENはBotFatherで作ったBotのトークン、TELEGRAM_CHAT_IDは承認者本人と
# Botの1対1チャットのID(このID以外からの承認操作は受け付けない)。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (ローカル実行時のみ。Actions上ではGITHUB_TOKENが自動付与される)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/fanza-dojin

# Hugging Face (任意)。サンプル画像検閲用モデル(EraX-NSFW-V1.0)のダウンロードに使う。
# 未設定でも匿名ダウンロードできるが、レート制限に引っかかりやすくなる。
HF_TOKEN=
